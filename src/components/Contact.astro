---
import { ui, EMAIL, GITHUB, LINKEDIN, WEB3FORMS_KEY, type Lang } from '../content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
// Com chave do Web3Forms, usa ele; sem chave, usa o FormSubmit (não exige conta:
// a primeira mensagem dispara um e-mail de ativação para o endereço abaixo).
const useWeb3 = !WEB3FORMS_KEY.startsWith('COLE');
const action = useWeb3 ? 'https://api.web3forms.com/submit' : `https://formsubmit.co/ajax/${EMAIL}`;
const subject = lang === 'pt' ? 'Contato pelo portfólio' : 'Portfolio contact';
---
<div class="contact">
  <div>
    <p class="lead">{t.contactLead}</p>
    <dl class="links sans">
      <dt>E-mail</dt><dd><a href={'mailto:' + EMAIL}>{EMAIL}</a></dd>
      <dt>LinkedIn</dt><dd><a href={LINKEDIN} rel="me">linkedin.com/in/joão-guilherme-matzenbacher</a></dd>
      <dt>GitHub</dt><dd><a href={GITHUB} rel="me">github.com/jgmtz</a></dd>
      <dt>{lang === 'pt' ? 'Local' : 'Location'}</dt><dd>Curitiba, Paraná</dd>
    </dl>
  </div>

  <form class="form sans" action={action} method="POST">
    {useWeb3
      ? <>
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value={subject} />
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </>
      : <>
          <input type="hidden" name="_subject" value={subject} />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </>}
    <label>{t.form.name}<input name="name" required autocomplete="name" /></label>
    <label>{t.form.email}<input name="email" type="email" required autocomplete="email" /></label>
    <label>{t.form.message}<textarea name="message" rows="5" required></textarea></label>
    <button class="btn solid" type="submit">{t.form.send}</button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>
</div>

<script define:vars={{ msg: t.form, email: EMAIL }}>
  const form = document.querySelector('.form');
  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const status = form.querySelector('.status');
    const btn = form.querySelector('button');
    btn.disabled = true;
    status.textContent = msg.sending;
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      const data = await res.json();
      if (!(data.success === true || data.success === 'true')) throw new Error();
      form.reset();
      status.textContent = msg.sent;
    } catch {
      status.innerHTML = `${msg.error} <a href="mailto:${email}">${email}</a>.`;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .lead { font-size: 19px; max-width: 40ch; }
  .links { display: grid; grid-template-columns: auto 1fr; gap: 8px 20px; margin-top: 22px; font-size: 15px; }
  .links dt { color: var(--muted); }
  .links dd { overflow-wrap: anywhere; }
  .form { display: grid; gap: 14px; font-size: 14px; }
  label { display: grid; gap: 6px; color: var(--muted); }
  input, textarea { font: 16px var(--sans); color: var(--text); background: var(--paper); border: 1px solid var(--rule); padding: 10px 12px; transition: border-color .3s, box-shadow .3s; }
  input:focus, textarea:focus { border-color: var(--copper); outline: none; box-shadow: 0 0 0 1px var(--copper); }
  .form button { justify-self: start; }
  .status { min-height: 1.5em; color: var(--muted); }
  @media (max-width: 760px) { .contact { grid-template-columns: 1fr; } }
</style>
